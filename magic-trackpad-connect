#!/usr/bin/env bash
set -euo pipefail

CONNECT_TIMEOUT="${CONNECT_TIMEOUT:-6}"

log() {
  printf '[magic-trackpad-connect] %s\n' "$*"
}

is_connected() {
  local mac="$1" info

  if ! info=$(bluetoothctl --timeout "$CONNECT_TIMEOUT" info "$mac" 2>/dev/null); then
    return 2
  fi
  grep -q "Connected: yes" <<< "$info"
}

find_trackpad_devices() {
  bluetoothctl --timeout "$CONNECT_TIMEOUT" devices Paired 2>/dev/null | awk '
    BEGIN { IGNORECASE = 1 }
    /magic[[:space:]]+trackpad/ { print $2 }
  '
}

connect_device() {
  local mac="$1" info_status

  if is_connected "$mac"; then
    log "already connected: $mac"
    return 0
  else
    info_status=$?
    if [ "$info_status" -eq 2 ]; then
      log "unable to query device: $mac"
      return 2
    fi
  fi

  if ! bluetoothctl --timeout "$CONNECT_TIMEOUT" connect "$mac" >/dev/null 2>&1; then
    log "connection unavailable: $mac"
    return 1
  fi

  if is_connected "$mac"; then
    log "connected: $mac"
    return 0
  else
    info_status=$?
    if [ "$info_status" -eq 2 ]; then
      log "unable to verify device: $mac"
      return 2
    fi
  fi

  log "connection not confirmed: $mac"
  return 1
}

main() {
  local mac from_env devices result found=0

  if ! command -v bluetoothctl >/dev/null 2>&1; then
    log "bluetoothctl not found"
    exit 2
  fi

  if [ -n "${MAGIC_TRACKPAD_MAC:-}" ]; then
    from_env="${MAGIC_TRACKPAD_MAC^^}"
    connect_device "$from_env"
    exit $?
  fi

  if ! devices=$(find_trackpad_devices); then
    log "unable to list paired Bluetooth devices"
    exit 2
  fi

  while IFS= read -r mac; do
    [ -n "$mac" ] || continue
    found=1
    if connect_device "$mac"; then
      exit 0
    else
      result=$?
      if [ "$result" -eq 2 ]; then
        exit 2
      fi
    fi
  done <<< "$devices"

  if [ "$found" -eq 0 ]; then
    log "no paired Magic Trackpad found"
    exit 0
  fi

  exit 1
}

main "$@"
