[Unit]
Description=Auto-connect paired Magic Trackpad
After=bluetooth.target
Wants=bluetooth.target

[Service]
Type=oneshot
Environment=CONNECT_TIMEOUT=4
ExecStart=%h/.local/bin/magic-trackpad-connect
# Exit 1 means a paired Trackpad is currently unavailable.
SuccessExitStatus=1
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
RestrictSUIDSGID=true
LockPersonality=true
PrivateTmp=true
