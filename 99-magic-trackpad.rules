# Grant input group access to Apple Magic Trackpad hidraw for battery reading
# GROUP="input" is used instead of TAG+="uaccess" because Bluetooth HID devices
# appear under /devices/virtual/misc/uhid/ which lacks ID_FOR_SEAT, preventing
# logind from applying the uaccess ACL.
SUBSYSTEM=="hidraw", DRIVERS=="magicmouse", MODE="0660", GROUP="input"
