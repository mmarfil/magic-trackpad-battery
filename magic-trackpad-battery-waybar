#!/usr/bin/env python3
"""Render Magic Trackpad battery state for a Waybar custom module."""

import html
import json
import os
import time


EMPTY_OUTPUT = {"text": ""}
MAX_STATE_AGE = 360  # seconds; daemon polls every 300 seconds


def render(state, now=None):
    """Convert validated daemon state to Waybar JSON data."""
    if not isinstance(state, dict) or state.get("connected") is not True:
        return EMPTY_OUTPUT

    percentage = state.get("percentage")
    charging = state.get("charging")
    device_name = state.get("device_name")
    updated_at = state.get("updated_at")
    if (
        type(percentage) is not int
        or not 0 <= percentage <= 100
        or type(charging) is not bool
        or not isinstance(device_name, str)
        or type(updated_at) is not int
    ):
        return EMPTY_OUTPUT

    if now is None:
        now = int(time.time())
    age = now - updated_at
    if not 0 <= age <= MAX_STATE_AGE:
        return EMPTY_OUTPUT

    if percentage <= 20:
        css_class = "critical"
    elif percentage <= 40:
        css_class = "warning"
    else:
        css_class = ""

    tooltip = f"{html.escape(device_name)}: {percentage}%"
    if charging:
        tooltip += " (charging)"

    return {
        "text": f'<span alpha="50%">MTP</span> {percentage}%',
        "class": css_class,
        "tooltip": tooltip,
    }


def main():
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime_dir:
        print(json.dumps(EMPTY_OUTPUT))
        return

    path = os.path.join(runtime_dir, "magic-trackpad-battery.json")
    try:
        with open(path) as state_file:
            state = json.load(state_file)
    except (OSError, UnicodeError, json.JSONDecodeError):
        state = None

    print(json.dumps(render(state)))


if __name__ == "__main__":
    main()
